<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened Runtime exceptions required for PyInstaller + PyQt5 -->
    <!-- Allow loading unsigned dylibs (PyInstaller onefirdir extracts at runtime) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Allow JIT (PyQt5/Python may use) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Disable library validation — PyInstaller bundles non-Apple dylibs -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Floating window: does not need camera/microphone/network -->
</dict>
</plist>
